  m_Text: "\u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435. \u041F\u043E\u0432\u0442\u043E\u0440\u0435\u043D\u0438\u0435
    \u043C\u0430\u0442\u044C \u0443\u0447\u0435\u043D\u0438\u044F. \u0417\u0430\u0445\u043E\u0434\u0438,
    \u0435\u0441\u043B\u0438 \u0442\u044B \u0437\u0430\u0431\u044B\u043B, \u043A\u0430\u043A
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0441\u0432\u043E\u0438
    \u0430\u0442\u0430\u043A\u0438."
