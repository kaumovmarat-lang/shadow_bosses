    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u0421\u043F\u0430\u0441\u0435\u043D\u0438\u0435 \u0434\u0443\u0445\u043E\u0432.\n\u0417\u0434\u0435\u0441\u044C
    \u0442\u044B \u0434\u043E\u043B\u0436\u0435\u043D \u0441\u043F\u0430\u0441\u0442\u0438
    \u0434\u0443\u0445\u043E\u0432 \u0443\u043C\u0435\u0440\u0448\u0438\u0445 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0446\u0435\u0432
    \u0438\u0437 \u0442\u0432\u043E\u0435\u0439 \u0441\u0433\u043E\u0440\u0435\u0432\u0448\u0435\u0439
    \u0434\u0435\u0440\u0435\u0432\u043D\u0438. \u0412 \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u043C
    \u043E\u043D\u0438 \u0441\u0442\u0430\u043D\u0443\u0442 \u0442\u0432\u043E\u0438\u043C\u0438
    \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u0430\u043C\u0438."
